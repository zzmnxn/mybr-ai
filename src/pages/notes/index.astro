---
import { getCollection } from 'astro:content';
import ListView from '../../components/ListView.astro';
import Shell from '../../layouts/Shell.astro';
import { getNotes } from '../../lib/graph';
const notes = await getNotes();
const plans = (await getCollection('planned')).map((p) => ({ id: p.data.id, title: p.data.title }));
---
<Shell title="전체 글" view="list" active="all">
  <ListView title="전체 글" note={`글 ${notes.length}편`} notes={notes} plans={plans} />
</Shell>
